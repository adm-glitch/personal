{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bluey-finder",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  // 20 searches per minute per visitor IP; the edge cache answers repeats for free.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "observability": { "enabled": true }
}
