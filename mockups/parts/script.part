<script id="blk" type="text/plain">/*__BLOCK__*/</script>
<script>
(async function(){
"use strict";
const errEl=()=>document.getElementById('loc-v');
window.addEventListener('error',ev=>{
  const l=errEl(); if(l){ l.textContent='render error'; l.style.color='var(--s-noanswer)';
    document.getElementById('loc-m').textContent=ev.message||''; }
});
const t0=Date.now();
const MUNI='__MUNI__', NBLAB='__NBLAB__', MAPMB='__MAPMB__';
document.getElementById('loc-v').textContent='Carregando '+MUNI+'…';

/* ================= decode =================
   The payload is exactly what the real app would ship: one gzipped binary of
   delta-varint geometry, decoded into typed arrays. 528.686 households do not
   fit in JS objects, so nothing here is ever materialised as one. */
const b64=document.getElementById('blk').textContent.trim();
const packed=Uint8Array.from(atob(b64),c=>c.charCodeAt(0));
const buf=await new Response(new Blob([packed]).stream()
            .pipeThrough(new DecompressionStream('gzip'))).arrayBuffer();
const D=new Uint8Array(buf);
let P=4;                                   // skip magic
function vi(){ let r=0,s=0,b; do{ b=D[P++]; r|=(b&0x7f)<<s; s+=7; }while(b&0x80); return r>>>0; }
function viz(){ const n=vi(); return (n&1)?-((n+1)>>>1):(n>>>1); }
const TD=new TextDecoder();
function rstr(){ const n=vi(); const s=TD.decode(D.subarray(P,P+n)); P+=n; return s; }
function rline(n){ const g=new Int32Array(n*2); let x=0,y=0;
  for(let i=0;i<n;i++){ x+=viz(); y+=viz(); g[i*2]=x; g[i*2+1]=y; } return g; }

const ST=rstr().split('\n');
const BN=rstr().split('\n');
const BP=[]; { const nb=vi();
  for(let b=0;b<nb;b++){ const nr=vi(), rs=[];
    for(let r=0;r<nr;r++) rs.push(rline(vi()));
    BP.push(rs); } }
const NQ=vi();
const qb=new Uint8Array(NQ), qnum=new Uint16Array(NQ), qgeo=new Uint8Array(NQ);
const qcx=new Int32Array(NQ), qcy=new Int32Array(NQ), qsetor=new Array(NQ);
{ let px=0,py=0;
  for(let i=0;i<NQ;i++){ qb[i]=vi(); qnum[i]=vi(); qgeo[i]=D[P++]; qsetor[i]=rstr();
    px+=viz(); py+=viz(); qcx[i]=px; qcy[i]=py; } }
const NF=vi();
const fq=new Int32Array(NF), ff=new Uint16Array(NF), fs=new Int32Array(NF), fr=new Uint16Array(NF);
const foff=new Int32Array(NF+1);
let fgAll;
{ const tmp=[]; let pq=0,tot=0;
  for(let i=0;i<NF;i++){ pq+=viz(); fq[i]=pq; ff[i]=vi(); fs[i]=vi(); fr[i]=vi();
    const n=vi(); const g=rline(n); tmp.push(g); foff[i]=tot; tot+=n*2; }
  foff[NF]=tot; fgAll=new Int32Array(tot); let o=0;
  for(const g of tmp){ fgAll.set(g,o); o+=g.length; } }
const NA=vi();
const ax=new Int32Array(NA), ay=new Int32Array(NA), aq=new Int32Array(NA),
      af=new Uint16Array(NA), asr=new Int32Array(NA);
{ let x=0,y=0; for(let i=0;i<NA;i++){ x+=viz(); y+=viz(); ax[i]=x; ay[i]=y; }
  let q=0;   for(let i=0;i<NA;i++){ q+=viz(); aq[i]=q; }
  for(let i=0;i<NA;i++) af[i]=vi();
  for(let i=0;i<NA;i++) asr[i]=vi(); }
/* number and complemento stay as bytes with offsets, decoded only when shown */
function strTable(){
  const len=vi(); const start=P; const off=new Int32Array(NA+1);
  let p=P;
  for(let i=0;i<NA;i++){ off[i]=p; let n=0,s=0,b; do{ b=D[p++]; n|=(b&0x7f)<<s; s+=7; }while(b&0x80); p+=n; }
  off[NA]=p; P=start+len;
  return {off, get(i){ let p=off[i],n=0,s=0,b; do{ b=D[p++]; n|=(b&0x7f)<<s; s+=7; }while(b&0x80);
    return n?TD.decode(D.subarray(p,p+n)):''; }};
}
const ANUM=strTable(), ACMP=strTable();
const NR=vi();
const rc=new Uint8Array(NR), rn=new Int32Array(NR), roff=new Int32Array(NR+1);
let rgAll;
{ const tmp=[]; let tot=0;
  for(let i=0;i<NR;i++){ rc[i]=D[P++]; rn[i]=vi()-1; const n=vi(); const g=rline(n);
    tmp.push(g); roff[i]=tot; tot+=n*2; }
  roff[NR]=tot; rgAll=new Int32Array(tot); let o=0;
  for(const g of tmp){ rgAll.set(g,o); o+=g.length; } }
const DUP=D.subarray(P,P+((NA+7)>>3)); P+=((NA+7)>>3);
const isDup=i=>(DUP[i>>3]>>(i&7))&1;
const NU=vi();
const uoff=new Int32Array(NU+1); let ugAll;
{ const tmp=[]; let tot=0;
  for(let i=0;i<NU;i++){ const n=vi(); const g=rline(n); tmp.push(g); uoff[i]=tot; tot+=n*2; }
  uoff[NU]=tot; ugAll=new Int32Array(tot); let o=0;
  for(const g of tmp){ ugAll.set(g,o); o+=g.length; } }

/* ================= indices ================= */
const KX=Math.cos(-1.42*Math.PI/180), M_UNIT=110574/1e6;
const fkey=(q,f)=>q*65536+f;
const faceIdx=new Map();                    // (q,f) -> face row
for(let i=0;i<NF;i++) faceIdx.set(fkey(fq[i],ff[i]),i);
const qFaces=new Map();                     // quadra -> [face rows]
for(let i=0;i<NF;i++){ let a=qFaces.get(fq[i]); if(!a){a=[];qFaces.set(fq[i],a);} a.push(i); }
const bQuadras=new Map();                   // bairro -> [quadras]
for(let i=0;i<NQ;i++){ let a=bQuadras.get(qb[i]); if(!a){a=[];bQuadras.set(qb[i],a);} a.push(i); }
/* addresses are sorted by (quadra, face), so each face owns a contiguous run */
const aRange=new Map();
{ let s=0;
  for(let i=1;i<=NA;i++){
    if(i===NA||aq[i]!==aq[s]||af[i]!==af[s]){ aRange.set(fkey(aq[s],af[s]),[s,i]); s=i; }
  } }
const qRange=new Map();
{ let s=0;
  for(let i=1;i<=NA;i++){ if(i===NA||aq[i]!==aq[s]){ qRange.set(aq[s],[s,i]); s=i; } } }

/* ================= coverage state =================
   Coverage is recorded on the FACE, never on a household. Nothing below is keyed to a
   door or a person: the household list is read-only context. The tallies are counters
   on the face, so "falei 7" is a number, not seven records — which is what keeps this
   out of LGPD Art. 11 entirely. Recomputing over 528k rows per frame is not an option,
   so the roll-ups stay incremental. */
const FLAB=['pendente','percorrida','parcial','inacessível','não autorizado','não existe'];
const FRES=new Uint8Array(6); [1,3,4,5].forEach(v=>FRES[v]=1);   // parcial stays pending
const FACTS=[[1,'Percorrida — passei em todas'],
             [2,'Parcial — falta voltar aqui'],
             [3,'Inacessível (segurança, alagamento)'],
             [4,'Não autorizado (condomínio, portaria)'],
             [5,'Não existe / sem moradia']];
const fstat=new Uint8Array(NF), ftalk=new Int16Array(NF), fabs=new Int16Array(NF);
/* household-weighted, so every existing seen/total display keeps its meaning */
const seenQ=new Int32Array(NQ), doneQ=new Int32Array(NQ);
const seenB=new Int32Array(BN.length), doneB=new Int32Array(BN.length);
const seenQF=new Int32Array(NQ);                    // faces touched, for "3/8 faces"
const totF=new Int32Array(NF), totQ=new Int32Array(NQ), totB=new Int32Array(BN.length);
for(const [kk,[s,e]] of aRange){
  const fi=faceIdx.get(kk); if(fi===undefined) continue;
  totF[fi]=e-s; totQ[fq[fi]]+=e-s; totB[qb[fq[fi]]]+=e-s;
}
const censusQ=new Int32Array(NQ), censusB=new Int32Array(BN.length);
for(let i=0;i<NF;i++){ censusQ[fq[i]]+=fr[i]; censusB[qb[fq[i]]]+=fr[i]; }
function setFace(fi,v){
  const old=fstat[fi]; if(old===v) return;
  const q=fq[fi], b=qb[q], hh=totF[fi];
  const ds=(v!==0?1:0)-(old!==0?1:0), dd=FRES[v]-FRES[old];
  seenQ[q]+=ds*hh; seenB[b]+=ds*hh; doneQ[q]+=dd*hh; doneB[b]+=dd*hh;
  seenQF[q]+=ds;
  if(v===0){ ftalk[fi]=0; fabs[fi]=0; }
  fstat[fi]=v;
}
let added=0, queued=0;

/* quadra display label: our own code + the streets that bound it */
const qcode=new Array(NQ), qlbl=new Array(NQ);
(function(){
  const strip=s=>s.normalize('NFD').replace(/[̀-ͯ]/g,'');
  for(const [b,qs] of bQuadras){
    qs.sort((a,c)=> (qcy[c]-qcy[a]) || (qcx[a]-qcx[c]));
    const w=strip(BN[b]).replace(/[()]/g,' ').split(/\s+/).filter(x=>x.length>2);
    const pre=(w.map(x=>x[0]).join('').slice(0,2)||'XX').toUpperCase();
    qs.forEach((q,i)=>qcode[q]=pre+'-'+String(i+1).padStart(2,'0'));
  }
  const short=n=>n.replace(/^(PASSAGEM|TRAVESSA|AVENIDA|RODOVIA|ESTRADA|ALAMEDA|RUA|VILA|CONJUNTO|CONDOMINIO)\s+/,'')
                  .toLowerCase().replace(/(^|\s)\S/g,c=>c.toUpperCase());
  for(let q=0;q<NQ;q++){
    const rows=(qFaces.get(q)||[]).slice().sort((a,b)=>fr[b]-fr[a]);
    const seen=[]; for(const r of rows){ const n=ST[fs[r]]; if(!seen.includes(n)) seen.push(n); if(seen.length>=2) break; }
    qlbl[q]=seen.map(short).join(' × ')||'quadra sem nome';
  }
})();
document.getElementById('loc-v').textContent=MUNI+' carregada';
console.log('decoded in',Date.now()-t0,'ms');
window.__CITY={NA,NF,NQ,NR,NU,bairros:BN.length};
/*__APP__*/
})();
</script>
